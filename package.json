{
  "name": "frameforge-monorepo",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "FrameForge: Production-grade Web-to-Editable-Figma capture engine, Chrome extension, and Figma plugin",
  "workspaces": [
    "packages/*",
    "apps/*",
    "fixtures/*"
  ],
  "scripts": {
    "build:figma": "node apps/figma-plugin/build.js",
    "build:extension": "node apps/chrome-extension/build.js",
    "build": "npm run build:figma && npm run build:extension",
    "test": "vitest run",
    "typecheck": "tsc -b",
    "generate:icons": "node scripts/generate-icons.js",
    "serve:fixture": "npx serve fixtures/test-site -p 3000"
  },
  "devDependencies": {
    "@types/node": "^22.13.0",
    "esbuild": "^0.28.2",
    "happy-dom": "^21.0.3",
    "typescript": "^5.7.3",
    "vitest": "^5.0.5"
  }
}
